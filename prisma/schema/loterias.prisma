model loterias {
  id                             String    @unique @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  acumulado                      Boolean
  dataApuracao                   String    @map("data_apuracao") @db.VarChar(10)
  dataProximoConcurso            String    @map("data_proximo_concurso") @db.VarChar(10)
  dezenasSorteadasOrdemSorteio   String[]  @map("dezenas_sorteadas_ordem_sorteio")
  exibirDetalhamentoPorCidade    Boolean   @map("exibir_detalhamento_por_cidade")
  indicadorConcursoEspecial      Int       @map("indicador_concurso_especial")
  listaDezenas                   String[]  @map("lista_dezenas")
  listaDezenasSegundoSorteio     String[]  @map("lista_dezenas_segundo_sorteio")
  localSorteio                   String    @map("local_sorteio") @db.VarChar(255)
  nomeMunicipioUFSorteio         String    @map("nome_municipio_uf_sorteio") @db.VarChar(255)
  nomeTimeCoracaoMesSorte        String    @map("nome_time_coracao_mes_sorte") @db.VarChar(255)
  numero                         Int       @id @unique
  numeroConcursoAnterior         Int       @map("numero_concurso_anterior")
  numeroConcursoFinal_0_5        Int       @map("numero_concurso_final_0_5")
  numeroConcursoProximo          Int       @map("numero_concurso_proximo")
  numeroJogo                     Int       @map("numero_jogo")
  observacao                     String
  tipoJogo                       String    @map("tipo_jogo") @db.VarChar(255)
  tipoPublicacao                 Int       @map("tipo_publicacao")
  ultimoConcurso                 Boolean   @map("ultimo_concurso")
  valorArrecadado                Decimal   @map("valor_arrecadado") @db.Decimal(14, 2)
  valorAcumuladoConcurso_0_5     Decimal   @map("valor_acumulado_concurso_0_5") @db.Decimal(14, 2)
  valorAcumuladoConcursoEspecial Decimal   @map("valor_acumulado_concurso_especial") @db.Decimal(14, 2)
  valorAcumuladoProximoConcurso  Decimal   @map("valor_acumulado_proximo_concurso") @db.Decimal(14, 2)
  valorEstimadoProximoConcurso   Decimal   @map("valor_estimado_proximo_concurso") @db.Decimal(14, 2)
  valorSaldoReservaGarantidora   Decimal   @map("valor_saldo_reserva_garantidora") @db.Decimal(14, 2)
  valorTotalPremioFaixaUm        Decimal   @map("valor_total_premio_faixa_um") @db.Decimal(14, 2)
  created                        DateTime  @default(now())
  modified                       DateTime  @updatedAt
  listaRateioPremio              prizes[]
  listaMunicipioUFGanhadores     winners[]

  @@index([id, numero])
}
